# ============================================================
# Khela TV — Environment Variables
# Copy to Vercel Project Settings > Environment Variables.
# Never commit real secrets. Rotate secrets if they leak.
# ============================================================

# --- Core (required) ---
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.khelatv.com
NEXT_PUBLIC_SITE_URL=https://www.khelatv.com

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI / Newsroom ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NEWSROOM_CRON_SECRET=

# --- Optional: Facebook auto-post ---
# FACEBOOK_PAGE_ID=
# FACEBOOK_ACCESS_TOKEN=

# Security notes:
# - NEXTAUTH_SECRET: generate with `openssl rand -base64 32`
# - NEWSROOM_CRON_SECRET: long random string; used as Bearer token for /api/cron/*
# - Rotate any secret immediately if exposed in logs or a public repo
